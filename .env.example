# Postgres connection (local dev: docker compose up -d)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vitals

# Oura OAuth2 application credentials (https://cloud.ouraring.com/oauth/applications)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Optional: uptime-kuma push monitor URL, pinged after a successful sync
HEARTBEAT_URL=

# Optional: password of the `tracker` login role (writes the day log tables,
# read-only elsewhere, no access to tokens). The sync creates/updates the role.
TRACKER_DB_PASSWORD=
